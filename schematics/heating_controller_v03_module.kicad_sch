(text "Pas de liaison GND_TBT / neutre. Les noms identiques sont relies dans ce module uniquement." (at 25.4 265.43 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "d522e41c-cbdf-545e-bc5f-94cd2e1dee35"))
(text "LED eteintes = contacts ouverts = absence de signal : CONFORT possible, pas ARRET garanti." (at 25.4 273.05 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "d7b8c857-2295-5d1c-8d0e-ff3deaf35855"))
(text "Le schema de principe ne contient ni borniers definitifs, ni fusibles, ni parafoudres valides." (at 25.4 279.4 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "603c1ffc-be3f-579d-b5d1-2765bbc1d6fe")))
