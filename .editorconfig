# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Generated KiCad and SVG artifacts keep their native formatting.
[*.{kicad_sch,kicad_sym,svg}]
indent_style = unset
indent_size = unset
